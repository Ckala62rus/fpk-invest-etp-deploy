# Vite production build — скопировать в frontend/.env.production перед npm run build
# cp deploy/env/frontend.env.production.example frontend/.env.production

# Same-origin: axios ходит на относительный /api (gateway проксирует)
VITE_API_BASE_URL=

VITE_APP_ORIGIN=https://etp.example.com

# Echo берёт схему/хост/порт из window.location — переключение HTTP↔HTTPS без rebuild
VITE_REVERB_ENABLED=true
VITE_REVERB_USE_PAGE_ORIGIN=true
VITE_REVERB_APP_KEY=change-me-reverb-key
# Ниже не используются при USE_PAGE_ORIGIN=true, но оставляем для документации
VITE_REVERB_HOST=etp.example.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# Horizon через тот же origin
VITE_HORIZON_URL=/horizon
