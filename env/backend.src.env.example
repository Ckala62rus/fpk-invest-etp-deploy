# Laravel production — скопировать в backend/src/.env на сервере
# cp deploy/env/backend.src.env.example backend/src/.env

APP_NAME="ЭТП ФПК Инвест"
APP_ENV=production
# Сгенерировать один раз до первого release внешней командой из ubuntu.md.
# Не выполняйте key:generate после запуска приложения.
APP_KEY=
APP_DEBUG=false

# Публичный URL (тот же хост, что у SPA — same-origin через gateway)
# HTTP:  http://etp.example.com
# HTTPS: https://etp.example.com
APP_URL=https://etp.example.com

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres-etp
DB_PORT=5432
DB_DATABASE=etp
DB_USERNAME=etp
DB_PASSWORD=change-me-strong-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Домен без схемы и без порта (или null при IP)
SESSION_DOMAIN=etp.example.com
# true только при HTTPS
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis-etp
REDIS_PASSWORD=null
REDIS_PORT=6379

# Reverb: браузер ходит на тот же домен через gateway (/app)
# PHP внутри Docker шлёт события на reverb-etp:6001
REVERB_APP_ID=etp
REVERB_APP_KEY=change-me-reverb-key
REVERB_APP_SECRET=change-me-reverb-secret
REVERB_HOST=etp.example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=6001
REVERB_INTERNAL_HOST=reverb-etp
REVERB_INTERNAL_PORT=6001
REVERB_INTERNAL_SCHEME=http

HORIZON_PATH=horizon

# Боевой SMTP. Для тестового Compose-профиля mailhog замените блок ниже:
# MAIL_MAILER=smtp
# MAIL_SCHEME=null
# MAIL_HOST=mailhog-etp
# MAIL_PORT=1025
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@etp.example.com"
MAIL_FROM_NAME="${APP_NAME}"

FRONTEND_URL=https://etp.example.com
SANCTUM_STATEFUL_DOMAINS=etp.example.com

ACTIVITY_LOGGER_ENABLED=true
ACTIVITY_LOGGER_TABLE_NAME=activity_log

# Сменить после первого входа
SUPER_ADMIN_INN=770000000000
SUPER_ADMIN_EMAIL=admin@etp.example.com
SUPER_ADMIN_PASSWORD=change-me-admin-password

# На боевом обычно не сидить демо-пользователей
DEMO_USERS_PASSWORD=
