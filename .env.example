# Compose (deploy/) — скопировать: cp .env.example .env

COMPOSE_PROJECT_NAME=etp-prod

HTTP_PORT=80
HTTPS_PORT=443

# Только для тестового профиля mailhog; UI доступен лишь на 127.0.0.1 сервера.
MAILHOG_UI_PORT=8025

# Только для тестового профиля pgadmin; UI доступен лишь на 127.0.0.1 сервера.
PGADMIN_PORT=5050
# Задайте в deploy/.env уникальные данные; не коммитьте их.
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

POSTGRES_DB=etp
POSTGRES_USER=etp
# Обязательно сменить на сервере
POSTGRES_PASSWORD=change-me-strong-password
